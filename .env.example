# docker compose 一键部署配置（复制为 .env 后填写真实 Key）
# cp .env.example .env

# SiliconFlow（视觉理解 / Embedding / ASR / 重排 / 文生图；不填则自动降级）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# DeepSeek（Agent 规划与总结；不填则走规则规划 + 模板回答）
DEEPSEEK_API_KEY=

# JWT 签名密钥（生产务必改成随机长串）
JWT_SECRET=change-me-to-a-long-random-secret

# 向量后端：local | milvus（milvus 需 docker compose --profile milvus up -d）
VECTOR_BACKEND=local
MILVUS_URI=http://milvus:19530
