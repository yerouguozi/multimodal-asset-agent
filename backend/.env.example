# 数据库（SQLite，SQLAlchemy 访问，日后可平滑换 PostgreSQL）
DATABASE_URL=sqlite:///./data/assets.db

# 素材与向量存储目录（相对 backend/）
UPLOAD_DIR=./data/uploads
VECTOR_STORE_PATH=./data/vectors.npz

# 入库模式：async=后台队列；sync=上传时同步处理（测试/小规模演示用）
INGESTION_MODE=async
WORKER_COUNT=2
MAX_RETRIES=3

# 跨域（前端开发地址）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SiliconFlow（视觉理解 + Embedding。不填则自动降级：不打标、仅关键词检索）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct
EMBEDDING_MODEL=BAAI/bge-m3
ASR_MODEL=FunAudioLLM/SenseVoiceSmall
RERANK_MODEL=BAAI/bge-reranker-v2-m3
VISION_MODEL_CHEAP=Qwen/Qwen3-VL-8B-Instruct
IMAGE_GEN_MODEL=Qwen/Qwen-Image
VL_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B
VL_EMBED_ENABLED=true
IMAGE_GEN_SIZE=1024x1024
VIDEO_MAX_FRAMES=4
AUDIO_MAX_SECONDS=600

# DeepSeek（文档摘要/标签。不填则跳过 LLM 摘要）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# JWT（质控平台等外部评测接入）
JWT_SECRET=change-me-to-a-long-random-secret
